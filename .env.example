# Admin-selected provider and model. Users cannot change these values in the UI.
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-2.5-sunburst

# Server-side language model interprets Vietnamese prompts and rewrites them
# for the image model. PROMPT_API_KEY may reuse OPENAI_API_KEY when endpoints
# match; a separate endpoint needs its own key (if authentication is required).
PROMPT_MODEL=gpt-6-luna
PROMPT_API_BASE_URL=https://api.openai.com/v1
PROMPT_API_KEY=
PROMPT_TIMEOUT_SECONDS=30

# Optional server-side model catalog. When set, IMAGE_ACTIVE_MODEL selects one
# alias. Change the alias and restart the app to switch models. Credentials and
# endpoint URLs remain in the provider variables below, never in this JSON.
# IMAGE_MODEL_CATALOG={"cloud":{"provider":"openai","model":"gpt-image-1"},"local":{"provider":"openai_compatible","model":"local-image-model"}}
# IMAGE_ACTIVE_MODEL=cloud

# OpenAI API. Set the key in a local ignored .env file.
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL override.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Self-hosted OpenAI-compatible endpoint; API key is optional.
# IMAGE_API_BASE_URL=http://127.0.0.1:8001/v1
# IMAGE_API_KEY=

# Set a unique random secret before starting a local backend.
# Docker Compose reads .secrets/session_secret through SESSION_SECRET_FILE.
SESSION_SECRET=
SESSION_TTL_SECONDS=1209600
# Set false only when using local HTTP without TLS.
SESSION_COOKIE_SECURE=true

IMAGE_DATABASE_PATH=var/image-studio.db
IMAGE_STORAGE_PATH=var/images
IMAGE_PROVIDER_TIMEOUT_SECONDS=180
FRONTEND_DIST_PATH=frontend/dist

# Optional LangSmith metadata-only tracing. Store the key in ignored .env or
# the deployment secret store. Prompts and image bytes are excluded from spans.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=image-studio

# Docker Compose uses this only for persistent volume naming if overridden.
# IMAGE_DATA_VOLUME=visual_assistant_image_data

# Local frontend host port. Pick another unused port if 8088 is occupied.
FRONTEND_PORT=8088

# Cloudflare Quick Tunnel needs no token or domain. It returns a temporary
# public trycloudflare.com URL. Use a remotely-managed tunnel and Access for
# stable domains or restricted access.
